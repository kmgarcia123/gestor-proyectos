# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (en Vercel: https://su-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Gestor de proyectos

# Recordatorios por correo (resend.com)
RESEND_API_KEY=
RECORDATORIOS_REMITENTE="Gestor de proyectos <avisos@sudominio.co>"

# Clave que protege la ruta del cron (cualquier texto largo y aleatorio)
CRON_SECRET=

# WhatsApp (API oficial de Meta) — Fase 2
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PLANTILLA=recordatorio_tareas_es
WHATSAPP_IDIOMA=es
WHATSAPP_API_VERSION=v23.0
